# Frontend sources and generated artifacts are written with LF; enforce it on checkout
# so cross-platform diffs stay clean and the generated-client drift check is reliable.
packages/frontend/** text eol=lf
package-lock.json text eol=lf

# The example app's frontend dogfoods the same codegen; its generated schema must be
# LF so the drift check is byte-stable cross-platform.
apps/example/frontend/** text eol=lf
# The example's own exported OpenAPI spec (its codegen source) is written LF by `terp openapi`.
apps/example/openapi.json text eol=lf

# The copier template's frontend slot renders to the same LF web sources.
template/project/frontend/** text eol=lf
template/project/conformance/** text eol=lf

# Docker + Compose files run in Linux containers (and the template renders them for a
# generated repo): keep them LF so they are byte-stable and shell-safe cross-platform.
**/Dockerfile text eol=lf
**/docker-compose.yml text eol=lf
**/docker-compose.yml.jinja text eol=lf
**/.dockerignore text eol=lf
**/.env.example text eol=lf

# The deployment declaration's schema is a byte-for-byte mirror of the Terp Standard's
# (ADR 0184), held equal to the pinned release by a byte comparison: LF on every checkout.
packages/backend/arch/src/terp/arch/deployment/deployment-declaration.schema.json text eol=lf

# The development-loop declaration's schema is the Terp Standard's too (ADR 0186), and its
# fixtures are carried for the reader's own tests: both held equal to the pinned release by
# a byte comparison, so both are LF on every checkout.
packages/backend/arch/src/terp/arch/workbench/workbench-declaration.schema.json text eol=lf
tests/architecture/workbench-declaration.fixtures.json text eol=lf

# The generator's golden samples and the reference app's production profile are compared
# with a render byte for byte (ADR 0187), so they are LF on every checkout, as the
# template's own build files are by the template's .gitattributes.
tests/architecture/generator_goldens/** text eol=lf
apps/reference/overlay/docker-compose.prod.yml text eol=lf
