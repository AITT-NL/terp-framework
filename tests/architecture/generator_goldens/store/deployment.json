{
  "schemaVersion": 1,
  "build": "generated",
  "compose": {
    "file": "docker-compose.prod.yml"
  },
  "units": [
    {
      "id": "db",
      "role": "database",
      "kind": "postgres",
      "version": "17",
      "stateful": true,
      "backup": {
        "every": "P1D",
        "keep": "P30D"
      }
    },
    {
      "id": "cache",
      "role": "store",
      "kind": "redis",
      "version": "7",
      "command": [
        "redis-server",
        "--appendonly",
        "yes"
      ]
    },
    {
      "id": "migrate",
      "role": "one-shot",
      "dependsOn": [
        "db"
      ]
    },
    {
      "id": "api",
      "role": "api",
      "healthPath": "/health/ready",
      "livenessPath": "/health/live",
      "dependsOn": [
        "db",
        "cache",
        "migrate"
      ]
    }
  ]
}
