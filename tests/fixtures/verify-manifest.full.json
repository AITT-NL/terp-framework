{
  "terp_verify_manifest": 1,
  "profile": "full",
  "categories": [
    "architecture",
    "backend-tests",
    "build",
    "conformance",
    "frontend-boundaries",
    "frontend-tests"
  ],
  "checks": [
    {
      "id": "platform-install",
      "category": "architecture",
      "command": "terp --version",
      "scope": [
        "pyproject.toml",
        "uv.lock",
        "**/package.json",
        "**/package-lock.json"
      ]
    },
    {
      "id": "env-seams",
      "category": "architecture",
      "command": "terp verify --only env-seams",
      "scope": [
        "environment.schema.json",
        ".app.env.example",
        "docker-compose*.yml"
      ]
    },
    {
      "id": "workbench",
      "category": "architecture",
      "command": "terp verify --only workbench",
      "scope": [
        "workbench.json",
        "docker-compose*.yml"
      ]
    },
    {
      "id": "deploy-safety",
      "category": "architecture",
      "command": "terp verify --only deploy-safety",
      "scope": [
        "docker-compose.prod.yml"
      ]
    },
    {
      "id": "production-readiness",
      "category": "architecture",
      "command": "terp verify --only production-readiness",
      "scope": [
        "control_plane/**/*.py"
      ]
    },
    {
      "id": "architecture",
      "category": "architecture",
      "command": "terp check --format check-report --budget escape-hatch-budget.json",
      "scope": [
        "app/**",
        "control_plane/**",
        "escape-hatch-budget.json"
      ]
    },
    {
      "id": "package-boundaries",
      "category": "architecture",
      "command": "lint-imports",
      "scope": [
        "pyproject.toml",
        "**/*.py"
      ]
    },
    {
      "id": "dependency-hygiene",
      "category": "architecture",
      "command": "uv run deptry .",
      "scope": [
        "pyproject.toml",
        "uv.lock",
        "**/*.py"
      ]
    },
    {
      "id": "backend-tests",
      "category": "backend-tests",
      "command": "uv run pytest",
      "scope": [
        "app/**",
        "control_plane/**",
        "tests/**",
        "conformance/**"
      ]
    },
    {
      "id": "appsec-baseline",
      "category": "architecture",
      "command": "uv run ruff check .",
      "scope": [
        "app/**",
        "control_plane/**",
        "tests/**"
      ]
    },
    {
      "id": "authz-surface",
      "category": "architecture",
      "command": "terp verify --only authz-surface",
      "scope": [
        "app/**",
        "control_plane/**",
        "authz-surface.json"
      ]
    },
    {
      "id": "dependency-audit-python",
      "category": "architecture",
      "command": "uv run --with pip-audit pip-audit --progress-spinner off",
      "scope": [
        "pyproject.toml",
        "uv.lock"
      ],
      "requires": "network access to the advisory databases"
    },
    {
      "id": "dependency-audit-npm",
      "category": "architecture",
      "command": "npm --prefix frontend audit --audit-level=high",
      "scope": [
        "frontend/package.json",
        "frontend/package-lock.json"
      ],
      "requires": "network access to the advisory databases"
    },
    {
      "id": "frontend-boundaries",
      "category": "frontend-boundaries",
      "command": "npm --prefix frontend run lint -- --format check-report",
      "scope": [
        "frontend/**",
        "escape-hatch-budget.json"
      ]
    },
    {
      "id": "routes-drift",
      "category": "build",
      "command": "npm --prefix frontend run routes -- --check",
      "scope": [
        "frontend/**"
      ]
    },
    {
      "id": "api-client",
      "category": "build",
      "command": "terp verify --only api-client",
      "scope": [
        "app/**",
        "control_plane/**",
        "frontend/package.json"
      ]
    },
    {
      "id": "frontend-typecheck",
      "category": "build",
      "command": "npm --prefix frontend run typecheck",
      "scope": [
        "frontend/**",
        "app/**"
      ]
    },
    {
      "id": "frontend-tests",
      "category": "frontend-tests",
      "command": "npm --prefix frontend test",
      "scope": [
        "frontend/**",
        "app/**"
      ]
    },
    {
      "id": "frontend-build",
      "category": "build",
      "command": "npm --prefix frontend run build",
      "scope": [
        "frontend/**",
        "app/**"
      ]
    }
  ]
}
