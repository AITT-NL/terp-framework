{
  "schemaVersion": 1,
  "build": "generated",
  "compose": {
    "file": "docker-compose.prod.yml"
  },
  "units": [
    {
      "id": "db",
      "role": "database",
      "kind": "postgres",
      "version": "17",
      "stateful": true,
      "backup": {
        "every": "P1D",
        "keep": "P30D"
      }
    },
    {
      "id": "migrate",
      "role": "one-shot",
      "dependsOn": [
        "db"
      ]
    },
    {
      "id": "api",
      "role": "api",
      "healthPath": "/health/ready",
      "livenessPath": "/health/live",
      "dependsOn": [
        "db",
        "migrate"
      ]
    },
    {
      "id": "web",
      "role": "web",
      "dependsOn": [
        "api"
      ]
    },
    {
      "id": "site",
      "role": "web",
      "healthPath": "/healthz"
    }
  ],
  "generator": {
    "recipes": {
      "$comment": "the site's image answers its health at /healthz alone, and a deploy tool waits on the path the unit declares",
      "site": "static-site"
    }
  }
}
