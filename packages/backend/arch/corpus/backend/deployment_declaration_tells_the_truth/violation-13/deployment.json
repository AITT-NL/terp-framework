{
  "schemaVersion": 1,
  "build": "own",
  "compose": {
    "file": "docker-compose.prod.yml"
  },
  "units": [
    {
      "id": "migrate",
      "role": "one-shot",
      "dependsOn": ["db"]
    },
    {
      "id": "api",
      "role": "api",
      "healthPath": "/health/ready",
      "livenessPath": "/health/live",
      "dependsOn": ["db", "migrate"]
    },
    {
      "id": "web",
      "role": "web",
      "dependsOn": ["api"]
    }
  ],
  "externalDatabase": {
    "backup": "client"
  }
}
