{
  "$comment": "Generated by scripts/build-tokens.mjs from themes.json, the per-theme token sources and token-pairs.json. Do not edit directly; regenerate with `npm run -w @terpjs/contract tokens`. CI fails on drift.",
  "base": "midday",
  "systemDark": "night",
  "themes": [
    {
      "name": "midday",
      "label": "Midday",
      "aliases": [
        "light"
      ],
      "appearance": "light",
      "description": "The default. Carries every token, including the geometry the other themes inherit.",
      "minimumContrast": 4.5
    },
    {
      "name": "twilight",
      "label": "Twilight",
      "aliases": [],
      "appearance": "dark",
      "description": "A dimmed violet dark between midday and evening: light text on violet-grey surfaces well above evening's near-black, for a room that is getting dark rather than one that is.",
      "minimumContrast": 4.5
    },
    {
      "name": "evening",
      "label": "Evening",
      "aliases": [
        "dark"
      ],
      "appearance": "dark",
      "description": "The slate-neutral dark counterpart to midday.",
      "minimumContrast": 4.5
    },
    {
      "name": "night",
      "label": "Night",
      "aliases": [
        "midnight"
      ],
      "appearance": "dark",
      "description": "A near-black dark for low light and OLED displays: cooler neutrals, a deeper canvas than evening, and a deeper accent that holds a white label at AA. The theme the OS dark preference selects.",
      "minimumContrast": 4.5
    },
    {
      "name": "contrast",
      "label": "High contrast",
      "aliases": [],
      "appearance": "light",
      "description": "A high-contrast light theme: white surfaces, near-black text, darkened accents and visible borders. Every declared text pairing reaches AAA, not just AA. Not wired to `prefers-contrast: more` — that needs a dark high-contrast counterpart first, or a user who asked for both more contrast and dark would be handed a light theme.",
      "minimumContrast": 7
    }
  ],
