{
  "name": "{{ project_slug }}-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "{{ project_name }} — React frontend on @terpjs/react-core + @terpjs/contract.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "lint": "terp-boundaries-lint",
    "test": "vitest run",
    "generate": "openapi-typescript ../openapi.json --output ./src/api/schema.d.ts",
    "routes": "terp-routes"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.16",
    "@terpjs/contract": "^0.25.0",
    "@terpjs/react-core": "^0.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@terpjs/eslint-boundaries": "^0.25.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "minimatch": "^10.2.5"
  }
}
