{% if layout == 'hub' -%}
// The hub landing is a dashboard: the app's key figures in the band under its title, and a
// card per area below. Both are placeholders until the first module lands -- point the cards at
// its routes, and give each figure its live value (`uv run terp guide layouts`). Every stable
// label is a cataloged UiText descriptor.
import { DashboardPage, Grid, HubCard, Stat, StatGroup, Text, Trans } from "@terpjs/react-core";
import { Link } from "@tanstack/react-router";
{%- else %}
{%- if layout in ['process', 'portal'] -%}
// The {{ layout }} landing is a placeholder HubPage. Point its cards at real module routes
// as those modules arrive; every stable label is a cataloged UiText descriptor.
import { HubCard, HubPage, Trans } from "@terpjs/react-core";
import { Link } from "@tanstack/react-router";
{%- endif %}
{%- endif %}
{%- if layout in ['hub', 'process', 'portal'] %}

const APP_TITLE = "{{ project_name }}";
{% if layout == 'process' -%}
const PAGE_TITLE = { id: "home.process.title", message: "Werkvoorraad" };
const NEW_TITLE = { id: "home.process.new.title", message: "Nieuw" };
const NEW_DESCRIPTION = { id: "home.process.new.description", message: "Hier komt de lijst met nieuwe aanvragen zodra het eerste onderdeel is gebouwd." };
const ACTIVE_TITLE = { id: "home.process.active.title", message: "In behandeling" };
const ACTIVE_DESCRIPTION = { id: "home.process.active.description", message: "Hier ga je verder met aanvragen waaraan al wordt gewerkt." };
const DONE_TITLE = { id: "home.process.done.title", message: "Afgerond" };
const DONE_DESCRIPTION = { id: "home.process.done.description", message: "Hier vind je afgeronde aanvragen en hun geschiedenis." };
{%- elif layout == 'portal' -%}
const PAGE_TITLE = { id: "home.portal.title", message: "Mijn overzicht" };
const CASES_TITLE = { id: "home.portal.cases.title", message: "Mijn zaken" };
const CASES_DESCRIPTION = { id: "home.portal.cases.description", message: "Hier komen de gegevens die bij jouw account horen zodra het eerste onderdeel is gebouwd." };
const ACTIONS_TITLE = { id: "home.portal.actions.title", message: "Openstaande acties" };
const ACTIONS_DESCRIPTION = { id: "home.portal.actions.description", message: "Hier ga je verder met wat nog aandacht of informatie nodig heeft." };
{%- else -%}
const PAGE_TITLE = APP_TITLE;
const FIRST_TITLE = { id: "home.hub.first.title", message: "Eerste onderdeel" };
const FIRST_DESCRIPTION = { id: "home.hub.first.description", message: "Hier komt je eerste onderdeel. Bouw het via de chat of met `terp new module`." };
const FIGURE_ONE = { id: "home.hub.figure.one", message: "Eerste kerncijfer" };
const FIGURE_TWO = { id: "home.hub.figure.two", message: "Tweede kerncijfer" };
const FIGURE_THREE = { id: "home.hub.figure.three", message: "Derde kerncijfer" };
{%- endif %}

export function Home() {
  return (
{%- if layout == 'hub' %}
    // The figures are the page's summary (ADR 0169): the dash until a module gives each one a
    // value, and a line saying so. The areas sit in a three-track section that becomes one
    // column on a phone; a fourth area joins the next row.
    <DashboardPage
      title={PAGE_TITLE}
      summary={
        <>
          <StatGroup>
            <Stat label={FIGURE_ONE} value={null} />
            <Stat label={FIGURE_TWO} value={null} />
            <Stat label={FIGURE_THREE} value={null} />
          </StatGroup>
          <Text tone="muted">
            <Trans
              id="home.hub.figures.note"
              message="Hier komen je kerncijfers zodra het eerste onderdeel gegevens heeft."
            />
          </Text>
        </>
      }
    >
      <Grid as="ul" template="1:1:1">
        <HubCard
          to="/"
          title={FIRST_TITLE}
          description={FIRST_DESCRIPTION}
          renderLink={({ to, children }) => <Link to={to}>{children}</Link>}
        />
      </Grid>
    </DashboardPage>
  );
}
{%- else %}
    <HubPage title={PAGE_TITLE}>
{% if layout == 'process' -%}
      <HubCard
        to="/"
        title={NEW_TITLE}
        description={NEW_DESCRIPTION}
        stat={<Trans id="home.process.new.stat" message="Te beoordelen" />}
        renderLink={({ to, children }) => <Link to={to}>{children}</Link>}
      />
      <HubCard
        to="/"
        title={ACTIVE_TITLE}
        description={ACTIVE_DESCRIPTION}
        stat={<Trans id="home.process.active.stat" message="Actief" />}
        renderLink={({ to, children }) => <Link to={to}>{children}</Link>}
      />
      <HubCard
        to="/"
        title={DONE_TITLE}
        description={DONE_DESCRIPTION}
        stat={<Trans id="home.process.done.stat" message="Archief" />}
        renderLink={({ to, children }) => <Link to={to}>{children}</Link>}
      />
{%- elif layout == 'portal' -%}
      <HubCard
        to="/"
        title={CASES_TITLE}
        description={CASES_DESCRIPTION}
        stat={<Trans id="home.portal.cases.stat" message="Persoonlijk" />}
        renderLink={({ to, children }) => <Link to={to}>{children}</Link>}
      />
      <HubCard
        to="/"
        title={ACTIONS_TITLE}
        description={ACTIONS_DESCRIPTION}
        stat={<Trans id="home.portal.actions.stat" message="Actie nodig" />}
        renderLink={({ to, children }) => <Link to={to}>{children}</Link>}
      />
{%- endif %}
    </HubPage>
  );
}
{%- endif %}
{%- else -%}
// The blank-shell landing. Product names and commands are intentionally not translated;
// every stable sentence goes through Trans and is checked against frontend/i18n.json.
import { Code, Page, Text, Trans } from "@terpjs/react-core";

const APP_TITLE = "{{ project_name }}";

export function Home() {
  return (
    <Page title={APP_TITLE}>
      <Text measure="base">
        <Trans
          id="home.blank.running"
          message="Je app draait: inloggen, beheer en audit zijn al aangesloten."
        />
      </Text>
      <Text measure="base">
        <Trans id="home.blank.add.before" message="Voeg je eerste module toe met" />{" "}
        <Code>uv run terp new module &lt;name&gt;</Code>{" "}
        <Trans
          id="home.blank.add.after"
          message="en deze verschijnt automatisch in de navigatie."
        />
      </Text>
    </Page>
  );
}
{%- endif %}
