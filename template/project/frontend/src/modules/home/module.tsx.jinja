import { defineModuleManifest } from "@terpjs/contract";

import { Home } from "./Home";

const APP_TITLE = "{{ project_name }}";

// The landing module ("/" belongs to it) — auto-discovered like every module slot.
export const manifest = defineModuleManifest({
  name: "home",
  routes: [{ path: "/", view: "Home" }],
  nav: [{
{% if layout == 'process' -%}
    label: { id: "home.process.title", message: "Werkvoorraad" },
{%- elif layout == 'portal' -%}
    label: { id: "home.portal.title", message: "Mijn overzicht" },
{%- else -%}
    label: APP_TITLE,
{%- endif %}
    to: "/",
    icon: "home",
  }],
});

export const views = { Home };
