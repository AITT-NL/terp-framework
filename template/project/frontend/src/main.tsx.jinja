// The design-token CSS variables the react-core primitives style against. Every shipped
// palette is in here — light, dark, midnight, twilight and contrast — and the shell
// header's theme toggle switches between them (plus "system", which follows the viewer's
// own platform preference) via <html data-theme>, with no per-module changes.
import "@terpjs/contract/tokens.css";
// This app's own token overlay, and the file to edit to change how it looks. Empty by
// default; it loads last, so anything it declares wins. `uv run terp guide theming` has
// the recipe. A tool may generate it — see the note at the top of theme.css.
import "./theme.css";
import { LOCALE_EN, LOCALE_NL, defineAppLocales, renderTerpApp } from "@terpjs/react-core";
// The app's layout declaration, checked in beside this file. ONE file, two readers: the
// `terp/layout-contract` lint rule finds it on disk, and the shell reads it here — so the
// contract is declared once instead of once per half. It also carries the shell's own shape
// (`shell.density`, `shell.navPlacement`, `shell.contentWidth`), the brand mark
// (`shell.brand`), the navigation groups the
// sidebar arranges items into (`shell.navGroups`: `{ "id", "label", "order" }` per group, with
// an empty label for a group that shows no heading), and the palette the app opens on before
// anyone picks one (`defaultTheme`: any of the five, or "system" to follow the viewer's own
// platform). Declaring any of those here as a bootstrap option as well is refused rather than
// silently resolved.
import layout from "../layout-contract.json";
import i18n from "../i18n.json";

// Product names are intentionally stable data, not locale copy. Hoisting also keeps the
// src-wide localization rule from mistaking this generated value for an untranslated UI literal.
const APP_TITLE = "{{ project_name }}";

// The whole app: discover the modules and mount. baseUrl defaults to same-origin so the
// Vite dev proxy forwards /api to the backend (uvicorn on :8000). Drop a module.tsx under
// modules/<name>/ (or run `uv run terp new module <name>`) and it is wired with no registration.
renderTerpApp({
  title: APP_TITLE,
  modules: import.meta.glob("./modules/*/module.tsx", { eager: true }),
  // Every archetype's body slot then accepts only the components the declared contract
  // allows; a failing check tells you exactly how to build the screen
  // (`terp guide layouts`). Drop `contract` from layout-contract.json to fall back to
  // archetype-only enforcement — one edit, in one place, and both halves follow.
  layout,
  // App copy lives in i18n.json and lint requires every target translation. The built-in
  // catalogs below provide the framework chrome around that app copy.
  locales: defineAppLocales(i18n, { en: LOCALE_EN, nl: LOCALE_NL }),
  sourceLocale: i18n.sourceLocale,
  // The brand mark lives in two places and neither implies the other: the mark inside the app
  // is declared in layout-contract.json, and `public/favicon.svg` is the mark in the browser
  // tab. Until both are replaced the app shows terp's placeholder in both.
  //
  // Drop the file in `public/` and name it in the declaration, not here:
  //
  //   "shell": { "brand": { "logo": "/logo.svg" } }
  //
  // A path rather than an element, because a file is what a tool can put somewhere — which is
  // why the Studio can set this for you and could never have written the JSX this comment used
  // to show. Passing `logo` as an option below still works for an app that wants an inline SVG
  // or a component; declaring the same mark both ways is refused.
  //
  // Sizing is the shell's, not yours: it renders the mark in a box of --shell-brand-size, so
  // a logo larger than the collapsed icon rail is scaled down rather than clipped. Move that
  // token from theme.css to change it.
  //
  // If the mark has fixed colours and cannot survive a dark theme — most company logos
  // cannot, and several of this app's palettes are dark — declare the second asset too and the
  // stylesheet picks by the palette in force, with no code of yours involved:
  //
  //   "shell": { "brand": { "logo": "/logo.svg", "logoDark": "/logo-dark.svg" } }
{%- if use_sso %}
  // The SSO button on the sign-in screen. The backend mounts the OIDC module once the
  // OIDC_* variables are set (see .env.example + app/auth.py); until then, clicking it
  // fails closed with a normal API error instead of silently hiding the configured path.
  ssoProviders: [{ name: "sso", label: { id: "auth.sso.label", message: "SSO" } }],
{%- endif %}
  // One-click fill of the seeded dev sign-in (app/seed.py). import.meta.env.DEV is
  // statically false in production builds, so the credentials never ship in a bundle.
  devCredentials: import.meta.env.DEV
    ? { email: "admin@example.test", password: "correct horse battery staple" }
    : undefined,
});
