// The design-token CSS variables the react-core primitives style against — both the
// light and dark palettes; the shell header's theme toggle (light/dark/system)
// switches them via <html data-theme> with no per-module changes.
import "@terpjs/contract/tokens.css";
// A Studio-managed styling overlay — empty by default, filled in when a theme
// is applied from the Studio's Themes settings screen (see theme.css).
import "./theme.css";
import { LOCALE_EN, LOCALE_NL, renderTerpApp } from "@terpjs/react-core";
// The app's layout declaration, checked in beside this file. ONE file, two readers: the
// `terp/layout-contract` lint rule finds it on disk, and the shell reads it here — so the
// contract is declared once instead of once per half. It also carries the shell's own shape
// (`shell.density`, `shell.navPlacement`, `shell.contentWidth`) and the palette the app opens
// on before anyone picks one (`defaultTheme`: any of the five, or "system" to follow the
// viewer's own platform). Declaring any of those here as a bootstrap option as well is refused
// rather than silently resolved.
import layout from "../layout-contract.json";

// The whole app: discover the modules and mount. baseUrl defaults to same-origin so the
// Vite dev proxy forwards /api to the backend (uvicorn on :8000). Drop a module.tsx under
// modules/<name>/ (or run `uv run terp new module <name>`) and it is wired with no registration.
renderTerpApp({
  title: "{{ project_name }}",
  modules: import.meta.glob("./modules/*/module.tsx", { eager: true }),
  // Every archetype's body slot then accepts only the components the declared contract
  // allows; a failing check tells you exactly how to build the screen
  // (`terp guide layouts`). Drop `contract` from layout-contract.json to fall back to
  // archetype-only enforcement — one edit, in one place, and both halves follow.
  layout,
  // The app's languages — English and Dutch out of the box (both catalogs ship complete).
  // Every react-core string (and every UiText prop) follows the header's picker; adding
  // another language is one more entry overriding the framework strings for that locale.
  locales: {
    en: LOCALE_EN,
    nl: LOCALE_NL,
  },
  // The brand mark lives in two places and neither implies the other: `logo` is the mark
  // inside the app, `public/favicon.svg` is the mark in the browser tab. Until both are
  // replaced the app shows terp's placeholder in both.
  //
  //   logo: <img src="/logo.svg" alt="" />,
  //
  // Sizing is the shell's, not yours: it renders the mark in a box of --shell-brand-size, so
  // a logo larger than the collapsed icon rail is scaled down rather than clipped. Move that
  // token from theme.css to change it.
  //
  // If the mark has fixed colours and cannot survive a dark theme — most company logos
  // cannot, and this app ships three dark themes — supply the second asset too and the
  // stylesheet picks per theme, with no code of yours involved:
  //
  //   logoDark: <img src="/logo-dark.svg" alt="" />,
{%- if use_sso %}
  // The SSO button on the sign-in screen. The backend mounts the OIDC module once the
  // OIDC_* variables are set (see .env.example + app/auth.py); until then, clicking it
  // fails closed with a normal API error instead of silently hiding the configured path.
  ssoProviders: [{ name: "sso", label: "Single sign-on" }],
{%- endif %}
  // One-click fill of the seeded dev sign-in (app/seed.py). import.meta.env.DEV is
  // statically false in production builds, so the credentials never ship in a bundle.
  devCredentials: import.meta.env.DEV
    ? { email: "admin@example.test", password: "correct horse battery staple" }
    : undefined,
});
