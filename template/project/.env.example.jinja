# Copy to `.env` and adjust; `docker compose` reads `.env` from this directory automatically.
#
# This file feeds the `${...}` interpolations in docker-compose.yml: the platform's own
# wiring and values only your host can resolve. It is NOT where this app's declared
# runtime variables go — those are declared in environment.schema.json and travel through
# `.app.env` (see .app.env.example). The two are not interchangeable: compose resolves
# `environment:` over `env_file:`, so a name set in both is taken from HERE and the
# `.app.env` copy is silently discarded. `terp verify --only env-seams` fails on that
# overlap. Details: `terp guide environment`.

# A strong secret (>= 32 chars) so issued JWTs stay valid across restarts. The compose file
# falls back to a dev default when this is unset, which is fine for a throwaway workbench but
# should be replaced with a real secret anywhere that matters.
SECRET_KEY=dev-secret-change-me-please-0123456789ab

# Host ports for the API and the frontend, in the range Terp owns (web 21100+, api 22100+):
# far away from 5173 / 8000 / 3000, which is where a developer's OTHER applications live.
# Change them if these two are taken as well -- the containers always talk to each other over
# the Compose network regardless, so only the host side moves.
#
# A workbench assigns these per project and passes them in, and its assignment outranks this
# file. Keeping them here is what makes a start OUTSIDE the workbench land on the same ports
# as one inside it, instead of falling back to whatever the compose file's default is.
API_PORT=22100
WEB_PORT=21100

# Compose sets this for you (Postgres). Uncomment for a NON-Docker local run: the settings
# default is in-memory SQLite, which the app boots on but no migration can act on, so
# `terp migrate upgrade` refuses it rather than report success against a database that
# disappears with the process.
# DATABASE_URL=sqlite:///./dev.db
{% if use_sso %}
# ---------------------------------------------------------------------------------
# Single sign-on (app/auth.py): the OIDC module mounts once these are set; leaving
# them unset boots the app with SSO off. The compose workbench forwards them into
# the api container.
# ---------------------------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:21100/auth/sso/callback
{% endif %}
# ---------------------------------------------------------------------------------
# Production profile (docker-compose.prod.yml). In ENVIRONMENT=production the app
# REFUSES to boot on unsafe values (terp.core.config).
# ---------------------------------------------------------------------------------

# Required in production — compose fails fast when unset. SECRET_KEY >= 32 chars.
# SECRET_KEY=<openssl rand -hex 32>
# POSTGRES_PASSWORD=<strong database password>

# CORS is deny-by-default; list explicit origins only if the SPA is NOT served
# same-origin behind the bundled web entrypoint (never '*' — production refuses it).
# BACKEND_CORS_ORIGINS=["https://app.your-domain.example"]

# Host port for the production web entrypoint (Terp's deployment range starts at 23100).
# WEB_PORT=23100
