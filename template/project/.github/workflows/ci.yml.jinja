name: ci

on:
  push:
  pull_request:

jobs:
  gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: uv sync
      # Lockstep (ADR 0063): a terp-* set at two versions is a pin someone forgot, not a
      # supported combination — so every verdict below would be about a platform that was
      # never released, in either direction. Refuse before spending the gate on it.
      - run: uv run terp verify --profile quick --only platform-install
      # Which seam actually supplies each declared variable. Compose resolves
      # `environment:` over `env_file:`, so a variable named in both is taken from the
      # developer's .env and the .app.env Studio renders never arrives — in every
      # environment, and invisibly, because nothing fails until the value is used. Reads
      # environment.schema.json and the compose files as data: no daemon, no containers.
      - run: uv run terp verify --profile quick --only env-seams
      # The architecture gate is the source of truth (== `terp check`).
      - run: uv run pytest
      # The delegated generic AppSec baseline (ADR 0085): ruff bandit (`S`) covers the
      # vulnerability classes the Terp rules deliberately don't duplicate. Blocking.
      - run: uv run ruff check .
      # Keep the generated API reference in lockstep with the installed kernel: regenerate
      # it and fail if a committed copy drifted (a no-op until you commit docs/).
      - run: uv run terp api-docs --out docs
      - run: git diff --exit-code -- docs

  # The React frontend type-checks and builds against @terpjs/react-core + @terpjs/contract.
  frontend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      # The typed client is generated, never committed (.gitignore), so CI has to
      # produce it before anything reads it — the app's live OpenAPI document, then
      # openapi-typescript into frontend/src/api/schema.d.ts. Vite erases type-only
      # imports, so `build` would pass without it and only `tsc` would fail: without
      # these steps the frontend half of the gate silently stops working the moment a
      # module actually calls the API, which is to say as soon as the app is an app.
      - uses: astral-sh/setup-uv@v5
      - run: uv sync
        working-directory: .
      - run: uv run terp openapi
        working-directory: .
      - run: npm install
      - run: npm run generate
      # The route types are extracted from the module manifests and committed (ADR 0092),
      # so `--check` refuses a table that no longer matches them. It runs before the
      # typecheck deliberately: a stale table fails the typecheck on the app's own
      # screens, where the real fault is one unregenerated artifact.
      - run: npm run routes -- --check
      - run: npm run typecheck
      # The boundary lint + escape-hatch budget: the frontend half of the gate. A violation
      # fails CI; a governed opt-out is a justified `terp-allow-*` marker counted in
      # escape-hatch-budget.json.
      - run: npm run lint
      - run: npm run build

  # End-to-end conformance: boot the Docker workbench (db -> migrate -> seed -> api + web) and drive
  # real browser auth flows with Playwright (the base-profile suite from @terpjs/conformance). Grow it
  # with your own module specs.
  conformance:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - run: npm install
        working-directory: conformance
      - name: Install Playwright (Chromium + OS deps)
        run: npx playwright install --with-deps chromium
        working-directory: conformance
      - name: Start the workbench
        run: docker compose up -d --wait api web seed
      - name: Run the conformance suite
        env:
          TERP_E2E_BASE_URL: http://localhost:5173
        working-directory: conformance
        run: npm test
      - name: Upload the Playwright report on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: conformance/playwright-report/
          retention-days: 7
      - name: Stop the workbench
        if: always()
        run: docker compose down -v
