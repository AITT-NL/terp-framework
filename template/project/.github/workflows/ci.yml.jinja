name: ci

# One definition of green, and it is not in this file. `terp verify` owns the check list
# (its PROFILES table); this workflow only installs the toolchain and supplies the
# preconditions a profile declares it needs.
#
# CI must never restate the checks. A restated list is frozen at the template version this
# app was rendered from while its packages keep moving, so the gate quietly stops
# verifying whatever was added since — and nothing goes red to say so. That is not
# hypothetical: it is how an app ends up type-checking against an API client that was
# never generated, reporting a green frontend, and failing the moment a module first
# imports the client. Adding a step here to fix a gap is the bug, not the fix; the gap
# belongs in the profile, where every driver of the gate — CI, an agent, Terp Studio —
# picks it up at once.

# Every `uses:` below is pinned BY DIGEST rather than by tag. A tag is a pointer
# its owner can move, and moving it changes what runs inside your CI with your
# repository checked out. `.github/dependabot.yml` beside this file is the other
# half: pinning without an updater only trades a live supply-chain risk for a
# stale one, so the two are shipped together and neither works alone.

on:
  push:
  pull_request:

# Read-only, declared rather than inherited. Without this block every job gets
# the repository default, which on many repositories is write — so a compromised
# dependency in any step below could push to your branches. Nothing here writes
# to the repository; a job that needs more says so for itself.
permissions:
  contents: read

jobs:
  gate:
    runs-on: ubuntu-latest
    # The second verified dialect (ADR 0069). Terp supports SQLite for development and
    # test and PostgreSQL for production, and refuses an unverified one at runtime — so
    # an app owner is told the matrix is real. Without a server here it would be real for
    # exactly one half of itself: every test taking `terp_db_url` would run on SQLite,
    # skip PostgreSQL, and report green, while the schema that ships is the one nobody
    # exercised.
    #
    # ON BY DEFAULT, deliberately. A commented-out service is an opt-in nobody is told
    # about, and the whole point of the fixture is that two-dialect testing stops being
    # something each project has to think of. It costs a container start; drop the block
    # and the env line below to turn it off, and the PostgreSQL half of every such test
    # goes back to skipping rather than failing.
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_PASSWORD: postgres
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432
    env:
      # Each test creates and force-drops its own scratch database on this server, so
      # the URL points at the maintenance database rather than at one they share.
      TERP_TEST_POSTGRES_URL: postgresql+psycopg://postgres:postgres@localhost:5432/postgres
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          # The checkout does not leave a credential behind in .git/config. Nothing
          # here pushes, and a persisted token is readable by every later step —
          # including anything a dependency brought along.
          persist-credentials: false
          # The secret-scanning lane reads the object graph, not the working tree: a
          # credential that was committed and later removed is gone from the tree and
          # still in the history, and that is the shape the incident usually takes. A
          # shallow clone would scan one commit and report clean.
          fetch-depth: 0
      - uses: astral-sh/setup-uv@d4b2f3b6ecc6e67c4457f6d3e41ec42d3d0fcb86 # v5.4.2
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: "22"
      - run: uv sync
      # Both manifests that pin @terpjs/*. The profile's platform-install check reads the
      # INSTALLED copy under each node_modules, not just the declared range, so they have
      # to be here for its verdict to mean anything — and a name left under the
      # pre-rename @terp/ scope fails at this step, loudly, instead of much later.
      - run: npm --prefix frontend install
      - run: npm --prefix conformance install
      # The merge bar. platform-install runs first and refuses a mixed install before the
      # rest of the run spends time proving things about a combination never released.
      - run: uv run terp verify --profile full
      # Release-profile checks cheap and deterministic enough to gate merges too. What is
      # left of that profile needs the workbench, which is the job below.
      - run: uv run terp verify --profile release --only api-docs-drift
      # The secret-scanning lane. Its own step rather than part of the profile, because
      # the check needs a tool on PATH and a full-depth checkout — preconditions a local
      # `terp verify --profile full` has no way to arrange, and failing there for a
      # missing binary would teach people to skip the profile.
      # The download is CHECKSUM-VERIFIED before it runs, and that is not ceremony:
      # this step fetches a binary over the network and executes it in a job that
      # has the repository checked out at full depth. An unverified fetch is the
      # exact supply-chain hole the tool it installs exists to find, one layer
      # down. Bump the version and the digest together -- a stale digest fails
      # loudly at `sha256sum -c`, which is the failure you want.
      - name: Install gitleaks
        env:
          GITLEAKS_VERSION: "8.30.1"
          GITLEAKS_SHA256: "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
        run: |
          curl -sSfL -o gitleaks.tgz "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
          echo "${GITLEAKS_SHA256}  gitleaks.tgz" | sha256sum -c -
          tar -xzf gitleaks.tgz gitleaks
          sudo install gitleaks /usr/local/bin/gitleaks
      - run: uv run terp verify --profile release --only secret-scanning

  conformance:
    # The release profile's `conformance` check with the precondition its manifest entry
    # declares (`requires:`) actually met: the Docker workbench up (db -> migrate -> seed
    # -> api + web), driven by real browser auth flows from @terpjs/conformance. Its own
    # job so a browser-level failure reads as one, and so the merge bar above stays fast.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@d4b2f3b6ecc6e67c4457f6d3e41ec42d3d0fcb86 # v5.4.2
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: "22"
      - run: uv sync
      - run: npm --prefix conformance install
      - name: Install Playwright (Chromium + OS deps)
        run: npx playwright install --with-deps chromium
        working-directory: conformance
      # `seed` is a one-shot: `--wait` treats any container that exits — even with 0 — as a
      # failure (docker/compose#10596), so it runs after the long-lived services are healthy.
      - name: Start the workbench
        run: |
          docker compose up -d --wait api web
          docker compose run --rm seed
      - run: uv run terp verify --profile release --only conformance
      - name: Upload the Playwright report on failure
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: playwright-report
          path: conformance/playwright-report/
          retention-days: 7
      - name: Stop the workbench
        if: always()
        run: docker compose down -v
