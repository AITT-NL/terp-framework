"""What every route does — declared once (ADR 0102).

Mirrors the event and job catalogs: a route declares the operation it performs,
and the control plane holds the one catalog those declarations are checked
against at boot. A capability declares its own operations *inside* its package
(it cannot reach into this app's control plane) and publishes them as one set;
this file folds every capability this app mounts into the single catalog below.

**Fold a capability in by splatting its set, never by naming its operations**
(ADR 0124). `*AUTH_OPERATIONS` grows when a release adds a route to the auth
capability, so this catalog grows with it and the app keeps booting. Listing the
constants one by one instead makes this file an inventory of somebody else's
routes: the day a release adds one, a `STRICT` catalog refuses the boot and the
only repair is to read the capability's source and copy the new name out of it.

Add your own module's operations here as you build them, next to the
capabilities — one place to read what this app can do, in plain English, without
tracing HTTP verbs and paths.
"""

from __future__ import annotations

from terp.core import OperationCatalog

from terp.capabilities.access import ACCESS_OPERATIONS
from terp.capabilities.audit import AUDIT_OPERATIONS
from terp.capabilities.auth import AUTH_OPERATIONS
from terp.capabilities.groups import GROUPS_OPERATIONS
from terp.capabilities.users import USERS_OPERATIONS
{%- if use_files %}
from terp.capabilities.files import FILES_OPERATIONS
{%- endif %}
{%- if use_sso %}
from terp.capabilities.oidc import OIDC_OPERATIONS
{%- endif %}
{%- if use_realtime %}
from terp.capabilities.realtime import REALTIME_OPERATIONS
{%- endif %}

operation_catalog = OperationCatalog(
    operations=(
        # Signing in, staying signed in, signing out.
        *AUTH_OPERATIONS,
        # Who exists, and what they may do.
        *USERS_OPERATIONS,
        *GROUPS_OPERATIONS,
        *ACCESS_OPERATIONS,
        # What happened.
        *AUDIT_OPERATIONS,
{%- if use_files %}
        # Attachments.
        *FILES_OPERATIONS,
{%- endif %}
{%- if use_sso %}
        # Single sign-on.
        *OIDC_OPERATIONS,
{%- endif %}
{%- if use_realtime %}
        # Live updates.
        *REALTIME_OPERATIONS,
{%- endif %}
    )
)

__all__ = ["operation_catalog"]
