"""Idempotent demo seed for {{ project_name }} — ``terp seed`` runs :func:`seed`.

Provisions a first administrator so the app is loginnable. Dev / demo only
(``terp seed`` refuses to run when ``ENVIRONMENT=production`` — bootstrap a real
admin with ``terp user create``). When your first module lands, extend this to
seed whatever makes the app useful to work on (create rows through the module's
real audited service, never with raw SQL).

Keep it deterministic as it grows: a second run on the same database writes
nothing, so a container may seed on every boot, and two fresh databases it seeds
hold the same business data. Look each row up by its natural key before creating
it, as ``ensure_user`` does, and never read the clock or a random value;
``terp guide testing`` shows the ``seed_checksum`` test that proves both.
"""

from __future__ import annotations

from sqlmodel import Session

from terp.core import Roles

from terp.capabilities.auth import DEMO_PASSWORD
from terp.capabilities.users import UserProvision, UsersService

_ADMIN_EMAIL = "admin@example.test"
# The password is the framework's DEMO_PASSWORD, the one every development seed signs in
# with: it satisfies the default PasswordPolicy, and `terp seed` refuses to run in
# production. Keep the literal out of this file. `no_hardcoded_credentials` reads every
# file of the app root (ADR 0136), so a literal here needs a governed marker and a count
# in the app's own escape-hatch budget.


def seed(session: Session) -> str:
    """Populate a fresh database with a usable admin (idempotent)."""
    users = UsersService()
    users.ensure_user(
        session,
        UserProvision(email=_ADMIN_EMAIL, password=DEMO_PASSWORD, role=int(Roles.ADMIN)),
    )
    return f"seeded admin ({_ADMIN_EMAIL})"
