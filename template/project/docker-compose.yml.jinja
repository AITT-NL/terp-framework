# {{ project_name }} — the full-stack dev workbench.
#
#   cp .env.example .env         # optional: set a strong SECRET_KEY
#   terp docker dev              # (or: docker compose watch) build, migrate, seed, then run
#
# Topology: Postgres (prod-parity DB) -> one-shot migrate -> one-shot seed -> the API
# (uvicorn) and the frontend (Vite). App and frontend source are bind-mounted straight
# from the checkout (uvicorn --reload + Vite HMR, both polling — reliable on every
# filesystem); dependency/manifest changes rebuild via compose watch.
name: {{ project_slug }}

# Shared backend definition — migrate / seed / api run the same image. Only the `api`
# service declares the build: one builder produces the tag (concurrent builds of a shared
# tag race in the exporter: "already exists"), the one-shots reuse it.
x-backend: &backend
  image: {{ project_slug }}-backend
  # App-declared environment variables (environment.schema.json): same seam as
  # the production profile, so a declared variable behaves identically in the
  # inner loop. `cp .app.env.example .app.env` to exercise it locally — that is
  # the file Studio renders per environment, so meeting it here rather than
  # first in a deployed environment is the point. Optional either way.
  env_file:
    - path: .app.env
      required: false
  # PRECEDENCE: compose resolves `environment:` OVER `env_file:`. A name that
  # appears below is therefore supplied by .env (or by the default written here)
  # and NEVER by .app.env — in every environment, including one with no .env at
  # all, where `${VAR:-}` still wins with an empty string. So: never list a
  # variable here that environment.schema.json declares. `terp verify --only
  # env-seams` fails the gate on exactly that overlap. What belongs here is the
  # platform's own wiring, plus values only the host can resolve.
  environment: &backend-env
    DATABASE_URL: postgresql+psycopg://app:app@db:5432/app
    SECRET_KEY: ${SECRET_KEY:-dev-secret-change-me-please-0123456789ab}
    ENVIRONMENT: local
{%- if use_sso %}
    # SSO (app/auth.py): the OIDC module mounts once these are set.
    #
    # These are forwarded from .env rather than declared in the manifest because
    # the workbench's SSO values are a developer's own throwaway IdP registration,
    # not an environment Studio deploys. If this app ever declares one of them in
    # environment.schema.json, delete it from this block in the same change —
    # keeping both makes the declaration dead.
    OIDC_ISSUER: ${OIDC_ISSUER:-}
    OIDC_CLIENT_ID: ${OIDC_CLIENT_ID:-}
    OIDC_CLIENT_SECRET: ${OIDC_CLIENT_SECRET:-}
    # Resolved by the BROWSER, not by a container: the IdP redirects the user's
    # browser here, so a host address (localhost:5173) is the correct value and a
    # compose service name would be wrong. This is the distinction the manifest
    # records as "resolvedBy" — see `terp guide environment`.
    OIDC_REDIRECT_URI: ${OIDC_REDIRECT_URI:-}
{%- endif %}
  volumes:
    # The API and one-shot migrate/seed processes execute the same live checkout.
    # TERP_DEV_HOST_ROOT is the checkout as the Docker daemon sees it.
    - ${TERP_DEV_HOST_ROOT:-.}/app:/app/app
    - ${TERP_DEV_HOST_ROOT:-.}/control_plane:/app/control_plane
{%- if use_files %}
    # Uploaded blobs survive container rebuilds.
    - files-data:/app/var/files
{%- endif %}

services:
  db:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: app
    # Not published to the host: the API reaches it over the Compose network (db:5432), so the
    # workbench never collides with a Postgres already running on the host. Add a
    # `ports: ["5433:5432"]` here to connect a database client from the host.
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 5s
      timeout: 5s
      retries: 10

  # One-shot: bring every package's schema up to head before the API serves.
  migrate:
    <<: *backend
    command: ["terp", "migrate", "upgrade", "--app-root", "/app/app"]
    depends_on:
      db:
        condition: service_healthy

  # One-shot: seed a usable admin (admin@example.test) + demo content. Idempotent, dev-only.
  seed:
    <<: *backend
    command: ["terp", "seed"]
    depends_on:
      migrate:
        condition: service_completed_successfully

  api:
    <<: *backend
    build:
      context: .
      dockerfile: Dockerfile
    # --timeout-graceful-shutdown: a realtime stream ends when its client goes away and not
    # otherwise, and uvicorn waits for in-flight tasks forever by default, so one open tab
    # would hold every reload. Three seconds, because the reload loop pays it per edit.
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--timeout-graceful-shutdown", "3"]
    environment:
      <<: *backend-env
      # Bind-mounted source can live on a filesystem without inotify (Docker
      # Desktop mounts, the Studio's checkout volume) — poll instead of miss.
      WATCHFILES_FORCE_POLLING: "true"
    ports:
      - "${API_PORT:-8000}:8000"
    depends_on:
      db:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/live')"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    develop:
      watch:
        - action: rebuild
          path: pyproject.toml

  web:
    build:
      context: .
      dockerfile: frontend/Dockerfile
    image: {{ project_slug }}-frontend
    command: ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
    environment:
      TERP_API_PROXY: http://api:8000
      # Poll the bind-mounted source (no inotify across Desktop/volume mounts).
      TERP_DEV_FORCE_POLLING: "true"
      # Who may embed this dev server in an iframe (frontend/vite.config.ts).
      # Empty — the default, and what a hand-run `terp docker dev` gets — means
      # `frame-ancestors 'none'`. A workbench that shows this app in a preview
      # pane exports its OWN browser origin here before starting the stack;
      # nothing inside the app can grant it, and nothing else needs to.
      TERP_DEV_FRAME_ANCESTORS: ${TERP_DEV_FRAME_ANCESTORS:-}
    ports:
      - "${WEB_PORT:-5173}:5173"
    volumes:
      # Live frontend source (see the api service's note on TERP_DEV_HOST_ROOT).
      - ${TERP_DEV_HOST_ROOT:-.}/frontend/src:/app/frontend/src
    depends_on:
      - api
    develop:
      watch:
        - action: rebuild
          path: frontend/package.json

volumes:
  db-data:
{%- if use_files %}
  files-data:
{%- endif %}
