[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }} — built on Terp"
requires-python = ">=3.13"
# terp-* distributions resolve from the package index (lockstep-versioned; see the
# platform CHANGELOG). Before a release is published, point uv at locally built wheels
# instead: `UV_FIND_LINKS=/path/to/terp-wheels uv sync` (the platform repo's
# template-acceptance CI job installs exactly this way).
dependencies = [
    "terp-core==0.27.0",
    "terp-cli==0.27.0",
    "terp-migrations==0.27.0",
    # Base profile: secure-by-default auth + identity + admin + audit.
    "terp-cap-auth==0.27.0",
    "terp-cap-identity==0.27.0",
    "terp-cap-users==0.27.0",
    "terp-cap-groups==0.27.0",
    "terp-cap-access==0.27.0",
    "terp-cap-audit==0.27.0",
{%- if use_files %}
    # File uploads: streamed storage + admin surface (auto-discovered, ADR 0056).
    "terp-cap-files==0.27.0",
{%- endif %}
{%- if use_sso %}
    # Single sign-on via OIDC (ADR 0058) — wired in app/auth.py, enabled by OIDC_* env.
    "terp-cap-oidc==0.27.0",
{%- endif %}
{%- if use_events %}
    # Domain events: typed catalog + in-process dispatch (ADR 0008).
    "terp-cap-eventbus==0.27.0",
{%- endif %}
{%- if use_realtime %}
    # Realtime: typed, policy-gated SSE + WebSocket channels (auto-discovered).
    "terp-cap-realtime==0.27.0",
{%- endif %}
]

[dependency-groups]
# uvicorn serves the local dev loop (`terp dev` / `uvicorn app.main:app`);
# the Docker images install their own pinned server.
#
# psycopg is the driver for the second verified dialect (ADR 0069). Terp supports SQLite
# for development and test and PostgreSQL for production, so a test that takes the
# shipped `terp_db_url` fixture runs on both -- and without the driver the PostgreSQL
# half could only ever skip, which would leave the schema that actually ships as the one
# nothing exercised. It is harmless locally: the lane skips when TERP_TEST_POSTGRES_URL
# names no server.
dev = ["pytest>=8.0", "httpx>=0.27", "pytest-cov>=5.0", "terp-arch==0.27.0", "uvicorn[standard]>=0.30", "ruff>=0.6", "deptry>=0.20", "psycopg[binary]>=3.2"]

# deptry: is every distribution this project imports one it declares? The
# question no Terp rule can answer -- mapping an import name to a distribution
# (`yaml` comes from PyYAML) needs installed metadata, and the gate reads source.
# So it is delegated (ADR 0033, the ADR 0085 precedent) and BLOCKING: it runs in
# `terp verify --profile full`, the merge bar. The failure it catches is a green
# gate over an undeclared import on a path no test reaches -- the app works on
# the machine where a transitive dependency happens to be installed and dies on
# a clean one. Declaring the table is what enables the check; delete it and the
# check skips with a note.
# Which roots the architecture gate scans, beyond `app/` itself. `control_plane` is
# declared because it is not an optional extra: it holds this app's permission,
# operation, event and job declarations, and a gate that scans only `app/` leaves them
# unchecked (platform ADR 0141). `terp check` and `terp verify` read this table with no
# flag, and tests/test_architecture.py spreads it into the harness call, so the two
# entry points cannot disagree about scope -- which matters because ONE escape-hatch
# budget covers every root listed here.
#
# A second DEPLOYABLE that create_app does not mount -- a worker, a publisher, a CLI --
# goes under `companions` instead, and is held to the rules that are about the code
# rather than about being a mounted app (`terp guide package-boundaries`):
#     companions = ["engine"]
[tool.terp.arch]
app_packages = ["control_plane"]

[tool.deptry]
known_first_party = ["app", "control_plane"]

[tool.deptry.per_rule_ignores]
# `terp.*` is one PEP 420 namespace spread across distributions, so an import of
# `terp.core` is not a transitive dependency of terp-cli; pydantic re-exports
# through sqlmodel and pydantic-settings.
DEP003 = ["terp", "pydantic"]

[tool.hatch.build.targets.wheel]
packages = ["app", "control_plane"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = "-q"
# terp-core ships the runtime-isolation plugin; strict mode additionally resets every
# runtime to the platform baseline before each test, so a test can only pass on a
# runtime it installed itself -- never on one a stray import installed at collection
# time. A new project starts clean, which is the one cheap moment to adopt it; turning
# it off later means accepting that a suite can be green together and red alone.
terp_strict_isolation = true

# The delegated generic AppSec baseline (ADR 0085): ruff's bandit-derived `S`
# rules cover the vulnerability classes the Terp Standard deliberately does NOT
# catalog (command injection, unsafe deserialization, weak hashes, ...) -- the
# terp.arch gate covers the Terp-specific architecture rules. Both run in CI
# (`uv run ruff check .` next to `uv run pytest`), and tests/test_architecture.py
# parses this stanza and fails on any weakening (a widened ignore, an exclude
# covering app code, a dropped CI step): weakening the baseline is a reviewed
# decision, never a silent one. Per-line opt-outs stay available as a `noqa`
# comment naming the S rule, with a reason.
[tool.ruff]
# Generated Alembic revisions are DDL, not app logic -- excluded exactly as the
# platform repo excludes its own.
extend-exclude = [".venv", "**/migrations/versions"]

[tool.ruff.lint]
# The name-only heuristics (S101 assert, S105/S106 "looks like a password") are
# excused platform-wide (ADR 0033); the high-signal rules stay on. What makes that
# excusal honest is the compensating control, so it is worth naming: terp.arch's
# `no_hardcoded_credentials` reads EVERY file of the scanned root (ADR 0136), not just
# `modules/`, and the `secret-scanning` verify check reads the git history, which no
# source rule can. Two halves the name heuristic was standing in for, both covered.
#
# `F` (pyflakes) rides along, and it is a restoration rather than an addition: `select`
# REPLACES ruff's default, so naming only `S` turned off the `E4`/`E7`/`E9`/`F` set ruff
# would otherwise run. That silently took F821 (undefined name) with it -- a correctness
# rule, not a tidiness one -- along with F401 unused-import and F841 unused-variable. The
# effect was a gate under which a file could carry a dead import, a dead local, or a
# genuine typo'd name and still pass every check the merge bar runs, because nothing else
# in the profile reads for it: terp.arch answers architecture questions and `S` answers
# security ones. Neither was ever going to notice.
select = ["S", "F"]
ignore = ["S101", "S105", "S106"]

[tool.ruff.lint.per-file-ignores]
# Tests legitimately spawn known subprocesses and use non-crypto randomness
# (root tests/ and any module-level tests/ tree alike).
"tests/**" = ["S603", "S607", "S311"]
"**/tests/**" = ["S603", "S607", "S311"]
