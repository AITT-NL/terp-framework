# Copy to `.env` and adjust; `docker compose` reads `.env` from this directory automatically.

# Local Compose supplies a development-only signing key. For production, generate a
# separate SECRET_KEY with `openssl rand -hex 32` and store it in the deployment's secrets.

# Host ports for the API and the frontend. Change these if 8000 / 5173 are already in use on
# your machine (the containers always talk to each other over the Compose network regardless).
API_PORT=8000
WEB_PORT=5173

# ---------------------------------------------------------------------------------
# Production profile (docker-compose.prod.yml — see docs/DEPLOYMENT.md). In
# ENVIRONMENT=production the app REFUSES to boot on unsafe values (terp.core.config).
# ---------------------------------------------------------------------------------

# Required in production — compose fails fast when unset. SECRET_KEY >= 32 chars.
# SECRET_KEY=<openssl rand -hex 32>
# POSTGRES_PASSWORD=<strong database password>

# Production publishes HTTP on loopback for a host TLS proxy. Set this to the
# intended host interface when the TLS ingress connects from another machine.
# TERP_BIND_ADDRESS=127.0.0.1

# The full database URL (the prod compose derives it from POSTGRES_PASSWORD; set it
# explicitly when pointing at a managed database instead of the bundled Postgres).
# DATABASE_URL=postgresql+psycopg://terp:<password>@db:5432/terp

# CORS is deny-by-default; list explicit origins only if the SPA is NOT served
# same-origin behind the bundled nginx (never '*' — production refuses it).
# BACKEND_CORS_ORIGINS=["https://app.your-domain.example"]

# Connection-pool tuning (ADR 0024).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Refresh-token sessions (ADR 0054). Secure cookie is derived (on outside local dev).
# REFRESH_TOKEN_TTL_SECONDS=604800
# REFRESH_FAMILY_TTL_SECONDS=1209600
# REFRESH_COOKIE_SECURE=true

# Host port for the production web entrypoint (nginx).
# WEB_PORT=8080
