{
  "name": "terp-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private component workbench for @terpjs/react-core — every component, every variant, every shipped theme, and the visual-regression baselines taken from them. Never published.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "visual": "playwright test",
    "visual:a11y": "playwright test visual/a11y.spec.ts",
    "visual:computed": "playwright test visual/computed.spec.ts",
    "visual:keyboard": "playwright test visual/keyboard.spec.ts",
    "visual:screens": "playwright test visual/specimens.spec.ts",
    "visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.45",
    "@terpjs/contract": "*",
    "@terpjs/react-core": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "license": "Apache-2.0"
}
