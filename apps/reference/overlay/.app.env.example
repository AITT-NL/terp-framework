# App-declared runtime variables — copy to `.app.env` to run the local workbench
# on the same seam the deployed environments use:
#
#     cp .app.env.example .app.env
#
# Generated by `terp env example` from environment.schema.json, which is the allow-list: a name
# here that is not declared there reaches no deployed environment. Re-run that
# command after changing a declaration rather than editing this file by hand.
#
# `.app.env` is gitignored and may hold secrets. This file is committed, so a
# variable declared `"format": "secret"` appears here with an EMPTY value.

# System actor
JOB_SYSTEM_ACTOR_ID=

# Sender
MAIL_FROM="Terp Reference <noreply@reference.example>"

# Relay authority
SMTP_CA_FILE=

# Relay host
SMTP_HOST=mailcatcher

# Relay password
# Declared secret: leave this empty, it is committed.
SMTP_PASSWORD=

# Relay port
SMTP_PORT=1025

# Relay security
SMTP_SECURITY=none

# Relay account
SMTP_USERNAME=
